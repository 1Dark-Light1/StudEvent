rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins are documents in /admins/{uid}; they are added only from the Firebase console
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Any signed-in user can read profiles (names of event participants).
    // Do not store private data (email, phone) here.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.get('photo', '').size() <= 200000;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /tasks/{taskId} {
      function isGlobal() {
        return resource.data.get('isGlobal', false) == true;
      }

      function isOwner() {
        return resource.data.userId == request.auth.uid;
      }

      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // Join/leave: the participants list changes only by the current user's uid
      function togglesOnlySelfInParticipants() {
        let before = resource.data.get('participants', []).toSet();
        let after = request.resource.data.get('participants', []).toSet();
        return after.difference(before).union(before.difference(after)) == [request.auth.uid].toSet();
      }

      // A user may change only their own entry in userCompletions
      function changesOnlyOwnCompletion() {
        let before = resource.data.get('userCompletions', {});
        let after = request.resource.data.get('userCompletions', {});
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
      }

      // A participant may only add themselves to completedBy, never remove others
      function addsOnlySelfToCompletedBy() {
        let before = resource.data.get('completedBy', []).toSet();
        let after = request.resource.data.get('completedBy', []).toSet();
        return after.hasAll(before) && after.difference(before).hasOnly([request.auth.uid]);
      }

      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.get('isGlobal', false) == true ||
        request.auth.uid in resource.data.get('participants', [])
      );

      // Only admins can create global events, and they start with no participants
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid && (
          request.resource.data.get('isGlobal', false) == false ||
          (isAdmin() && request.resource.data.get('participants', []).size() == 0)
        );

      allow update: if signedIn() && (
        // Owner edits their task; owner and global flag cannot be changed (except by admin)
        (isOwner() &&
          request.resource.data.userId == resource.data.userId &&
          (request.resource.data.get('isGlobal', false) == resource.data.get('isGlobal', false) || isAdmin())) ||
        // Admin edits any global event, but cannot reassign its owner
        (isGlobal() && isAdmin() && request.resource.data.userId == resource.data.userId) ||
        // Any user joins or leaves a global event
        (isGlobal() && changedOnly(['participants']) && togglesOnlySelfInParticipants()) ||
        // Any user updates their own completion status on a global event
        (isGlobal() && changedOnly(['userCompletions']) && changesOnlyOwnCompletion()) ||
        // A participant marks a global event as completed
        (isGlobal() &&
          request.auth.uid in resource.data.get('participants', []) &&
          changedOnly(['completedBy', 'completedAt']) &&
          addsOnlySelfToCompletedBy())
      );

      allow delete: if signedIn() && (isOwner() || (isGlobal() && isAdmin()));
    }

    match /messages/{messageId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
